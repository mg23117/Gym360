<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Capa inferior: Gradiente lineal que actúa como el borde -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="12dp" />
            <gradient
                android:startColor="@color/gym_plum"
                android:endColor="@color/gym_red"
                android:type="linear"
                android:angle="0" />
        </shape>
    </item>

    <!-- Capa superior: Fondo rosa del botón con márgenes (2dp) para revelar el borde -->
    <item
        android:bottom="3dp"
        android:left="3dp"
        android:right="3dp"
        android:top="3dp">
        <shape android:shape="rectangle">
            <corners android:radius="10dp" />
            <solid android:color="@color/gym_pink" />
        </shape>
    </item>
</layer-list>