<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground"
    android:fillViewport="true">

    <!-- Contenedor principal alineado al centro -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Logo de Gym360 -->
        <com.google.android.material.card.MaterialCardView
            style="@style/GymCard"
            android:layout_width="160dp"
            android:layout_height="151dp"
            android:layout_marginTop="32dp"
            android:layout_marginBottom="20dp"
            app:contentPadding="0dp"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardElevation="0dp"> <!-- Quitamos la sombra para que solo quede el redondeo -->

            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@mipmap/ic_gym360_logo" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Título -->
        <TextView
            android:id="@+id/tvLoginTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:fontFamily="@font/main_font"
            android:text="Iniciar Sesión"
            android:textColor="@color/text_primary"
            android:textSize="24sp"
            android:textStyle="bold" />

        <!-- Botón de Continuar con Google -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnGoogleLogin"
            style="@style/GymButton.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Continuar con Google"
            app:icon="@mipmap/ic_google_logo_foreground"
            app:iconSize="27dp"
            app:iconTint="@null"/>

        <!-- Separador -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="o"
            android:textColor="@color/gym_pink" />

        <!-- Campo de Correo Electrónico -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail"
            style="@style/GymTextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:hint="Correo Electrónico"
            app:startIconDrawable="@android:drawable/ic_dialog_email"
            app:errorEnabled="true"> <!-- Habilita mensajes de error visuales -->

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                style="@style/GymTextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="55dp"
                android:inputType="textEmailAddress" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Campo de Contraseña -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPassword"
            style="@style/GymTextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:hint="Contraseña"
            app:startIconDrawable="@drawable/ic_lock_large"
            app:endIconMode="password_toggle"
            app:errorEnabled="true">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPassword"
                style="@style/GymTextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="55dp"
                android:inputType="textPassword" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Botón de Iniciar Sesión -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogin"
            style="@style/GymButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Iniciar Sesión" />

        <!-- Enlace a Registro -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="¿No tienes una cuenta? "
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvGoToRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Crea una"
                android:textColor="@color/gym_pink"
                android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>