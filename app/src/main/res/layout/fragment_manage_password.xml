<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="?android:attr/windowBackground">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Por seguridad, ingresa tu contraseña actual antes de realizar el cambio."
        android:textColor="@color/text_secondary"
        android:textSize="16sp" />

    <!-- Contraseña Actual -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilCurrentPassword"
        style="@style/GymTextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="Contraseña actual"
        app:endIconMode="password_toggle"
        app:startIconDrawable="@drawable/ic_lock_large">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etCurrentPassword"
            style="@style/GymTextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:paddingStart="55dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Nueva Contraseña -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilNewPassword"
        style="@style/GymTextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="Nueva contraseña"
        app:endIconMode="password_toggle"
        app:startIconDrawable="@drawable/ic_lock_large">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNewPassword"
            style="@style/GymTextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:paddingStart="55dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Confirmar Nueva Contraseña -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilConfirmNewPassword"
        style="@style/GymTextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:hint="Confirmar nueva contraseña"
        app:endIconMode="password_toggle"
        app:startIconDrawable="@drawable/ic_lock_large">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etConfirmNewPassword"
            style="@style/GymTextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:paddingStart="55dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSaveNewPassword"
        style="@style/GymButton.Primary.Large"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Cambiar Contraseña" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBackToProfile"
        style="@style/GymButton.Secondary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Volver a mi perfil" />

</LinearLayout>