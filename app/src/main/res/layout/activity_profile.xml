<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="?android:attr/windowBackground"
    android:orientation="vertical">

    <!-- Toolbar superior -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/topAppBarProfile"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/app_surface"
        android:elevation="4dp"
        app:navigationIcon="@drawable/ic_side_nav_menu"
        app:title="Mi Perfil"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
        app:titleTextColor="@color/text_primary" />

    <!-- Línea divisoria debajo de la Toolbar -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/toolbar_divider" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Avatar del usuario -->
            <ImageView
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:src="@drawable/ic_person"
                app:tint="@color/gym_pink" />

            <TextView
                android:id="@+id/tvProfileEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:text="usuario@correo.com"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <!-- Alerta de Sincronización Pendiente (Requerimiento 9) -->
            <!-- Por defecto estará en visibility="gone", se mostrará por código si hay datos pendientes -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cvSyncAlert"
                style="@style/GymCard.Highlighted"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardBackgroundColor="#FF9800"
                android:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="12dp"
                        android:src="@android:drawable/ic_popup_sync"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Tienes datos pendientes por subir a la nube."
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSyncNow"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sincronizar"
                        android:textColor="@color/white" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Actualizar Datos"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- Actualizar Nombre Completo -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilUpdateName"
                style="@style/GymTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Nombre completo"
                app:startIconDrawable="@drawable/ic_person">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUpdateName"
                    style="@style/GymTextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName"
                    android:paddingStart="55dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Actualizar Contraseña -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilUpdatePassword"
                style="@style/GymTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:hint="Nueva contraseña"
                app:endIconMode="password_toggle"
                app:startIconDrawable="@drawable/ic_lock_large">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUpdatePassword"
                    style="@style/GymTextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:paddingStart="55dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Confirmar Contraseña (Requerimiento 6) -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilConfirmUpdatePassword"
                style="@style/GymTextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                android:hint="Confirmar nueva contraseña"
                app:endIconMode="password_toggle"
                app:startIconDrawable="@drawable/ic_lock_large">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etConfirmUpdatePassword"
                    style="@style/GymTextInputEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword"
                    android:paddingStart="55dp" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Botón de Guardar Cambios -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSaveChanges"
                style="@style/GymButton.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:text="Actualizar Perfil" />

            <!-- Botón de Cerrar Sesión -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                style="@style/GymButton.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Cerrar Sesión" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>