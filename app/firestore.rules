rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Comprueba que el usuario esté autenticado
    // y registrado como administrador.
    function isAdmin() {
      return request.auth != null
        && exists(
          /databases/$(database)/documents/admin_users/$(request.auth.uid)
        );
    }

    // Registros de administradores.
    match /admin_users/{uid} {
      // Cada usuario autenticado puede consultar
      // únicamente su propio documento.
      allow get: if request.auth != null
                 && request.auth.uid == uid;

      // La aplicación no puede modificar estos registros.
      allow create, update, delete, list: if false;
    }

    // Catálogo de membresías.
    match /memberships/{membershipId} {
      allow read: if isAdmin();

      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll([
          'id',
          'name',
          'durationMonths',
          'price',
          'benefits'
        ])
        && request.resource.data.keys().hasOnly([
          'id',
          'name',
          'durationMonths',
          'price',
          'benefits'
        ])
        && request.resource.data.id == membershipId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.durationMonths is int
        && request.resource.data.durationMonths > 0
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.benefits is list;

      allow delete: if isAdmin();
    }
  }
}