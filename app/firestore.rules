rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }

    match /admin_users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    // Perfiles de usuarios: cada cliente puede crear y leer solo su perfil.
    match /users/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, update, delete: if false;
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasAll([
          'uid', 'fullName', 'email', 'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'uid', 'fullName', 'email', 'createdAt'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.uid is string
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 7
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;
    }

    match /memberships/{membershipId} {
      allow read: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll([
          'id', 'name', 'durationMonths', 'price', 'benefits'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'durationMonths', 'price', 'benefits'
        ])
        && request.resource.data.id == membershipId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.durationMonths is int
        && request.resource.data.durationMonths > 0
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.benefits is list;
      allow delete: if isAdmin();
    }
  }
}
