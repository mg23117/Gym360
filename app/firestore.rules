rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admin_users/$(request.auth.uid));
    }
    match /admin_users/{uid} {
      allow get: if owner(uid);
      allow list, create, update, delete: if false;
    }
    match /users/{uid} {
      allow get: if owner(uid) || isAdmin();
      allow list: if isAdmin();
      allow delete: if false;
      allow create: if owner(uid)
        && request.resource.data.keys().hasAll(['uid', 'fullName', 'email', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'fullName', 'email', 'createdAt'])
        && request.resource.data.uid == uid
        && request.resource.data.uid is string
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 7
        && request.resource.data.fullName.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow update: if owner(uid)
        && request.resource.data.keys().hasAll(['uid', 'fullName', 'email', 'createdAt'])
        && request.resource.data.keys().hasOnly(['uid', 'fullName', 'email', 'createdAt'])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fullName'])
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.fullName is string
        && request.resource.data.fullName.size() >= 7
        && request.resource.data.fullName.size() <= 120;
      match /membership_purchases/{purchaseId} {
        allow read: if owner(uid) || isAdmin();
        allow create, update, delete: if false;
      }
    match /cart/{productId} {
        allow read: if owner(uid);
        allow create, update: if owner(uid)
          && request.resource.data.keys().hasAll(['productId','quantity','updatedAt'])
          && request.resource.data.keys().hasOnly(['productId','quantity','updatedAt'])
          && request.resource.data.productId == productId
          && request.resource.data.quantity is int
          && request.resource.data.quantity >= 1
          && request.resource.data.quantity <= 99
          && request.resource.data.updatedAt == request.time;
        allow delete: if owner(uid);
      }
    }
    match /memberships/{membershipId} {
      // Para que el cliente pueda consultar el catálogo.
      allow read: if signedIn();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll([
          'id', 'name', 'durationMonths', 'price', 'benefits'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'name', 'durationMonths', 'durationDays', 'price', 'benefits'
        ])
        && request.resource.data.id == membershipId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.durationMonths is int
        && request.resource.data.get('durationDays', 0) is int
        && (
          (request.resource.data.durationMonths > 0 &&
            request.resource.data.durationMonths <= 120 &&
            request.resource.data.get('durationDays', 0) == 0)
          ||
          (request.resource.data.durationMonths == 0 &&
            request.resource.data.get('durationDays', 0) in [1, 15])
        )
        && request.resource.data.price is number
        && request.resource.data.price >= 0
        && request.resource.data.price <= 500000
        && request.resource.data.benefits is list;
      allow delete: if isAdmin();
    }
    match /wallets/{uid} {
      allow get: if owner(uid) || isAdmin();
      allow list: if isAdmin();
      // Las operaciones monetarias SOLO se realizan en el backend.
      allow create, update, delete: if false;
      match /transactions/{operationId} {
        allow read: if owner(uid) || isAdmin();
        allow create, update, delete: if false;
      }
    }
    match /user_memberships/{uid} {
      allow get: if owner(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if false;
    }
  // CATÁLOGO: clientes solo ven productos activos mediante whereEqualTo("isActive", true).
    match /products/{productId} {
      function validProduct() {
        return request.resource.data.keys().hasAll([
          'id','name','description','category','priceCents','stock','imageUrls','isActive','createdAt','updatedAt'
        ])
        && request.resource.data.keys().hasOnly([
          'id','name','description','category','priceCents','stock','imageUrls','isActive','createdAt','updatedAt'
        ])
        && request.resource.data.id == productId
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 2
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 3000
        && request.resource.data.category in ['Suplementos','Bebidas','Ropa','Accesorios','Equipamiento','Snacks','Otros']
        && request.resource.data.priceCents is int
        && request.resource.data.priceCents >= 0
        && request.resource.data.priceCents <= 50000000
        && request.resource.data.stock is int
        && request.resource.data.stock >= 0
        && request.resource.data.stock <= 1000000
        && request.resource.data.imageUrls is list
        && request.resource.data.imageUrls.size() <= 5
        && request.resource.data.isActive is bool;
      }
      allow get, list: if isAdmin() || (signedIn() && resource.data.isActive == true);
      allow create: if isAdmin() && validProduct()
        && request.resource.data.stock == 0
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // El SDK Android solo modifica metadatos; el backend gestiona TODO el stock.
      allow update: if isAdmin() && validProduct()
        && request.resource.data.id == resource.data.id
        && request.resource.data.stock == resource.data.stock
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name','description','category','priceCents','imageUrls','isActive','updatedAt'
        ]);
      // Soft delete: isActive=false, conservar ventas históricas.
      allow delete: if false;
      match /stock_movements/{operationId} {
        allow read: if isAdmin();
        allow create, update, delete: if false;
      }
    }

    // PEDIDOS: creación, cambios de estado, cobros y reembolsos solo mediante Render.
    match /orders/{orderId} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.userUid == request.auth.uid);
      allow create, update, delete: if false;
      match /events/{operationId} {
        allow read: if isAdmin();
        allow create, update, delete: if false;
      }
    }
  }
}
